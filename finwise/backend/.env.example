# Copy to .env and fill in. NEVER commit .env.
# Flask session signing key. Generate one:  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite by default; any SQLAlchemy URL works.
DATABASE_URL=sqlite:///finwise.db

# OPTIONAL. Leave blank to use the rule-based assistant fallback.
# Read server-side only — never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set to 1 only behind HTTPS.
SESSION_COOKIE_SECURE=0
